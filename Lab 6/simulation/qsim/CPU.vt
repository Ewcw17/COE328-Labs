`timescale 1 ps/ 1 ps
module CPU_vlg_sample_tst(
	A,
	B,
	clk,
	data_in,
	Enable,
	res,
	sampler_tx
);
input [7:0] A;
input [7:0] B;
input  clk;
input  data_in;
input  Enable;
input  res;
output sampler_tx;

reg sample;
time current_time;
always @(A or B or clk or data_in or Enable or res)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

