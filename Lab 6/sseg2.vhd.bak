LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY sseg2 IS
	PORT ( bcd : IN STD_LOGIC_VECTOR(3 DOWNTO 0);
		   leds, nleds : OUT STD_LOGIC_VECTOR(1 TO 7) );
END sseg2;

ARCHITECTURE Behavior OF sseg2 IS
BEGIN
	PROCESS (bcd)
	BEGIN
		CASE bcd IS             -- abcdefg
			WHEN "0000" => leds <= "1001111";
			WHEN "0001" => leds <= "0010010";
			WHEN "0010" => leds <= "0000110";
			WHEN "0011" => leds <= "1001100";
			WHEN "0100" => leds <= "0100100";
			WHEN "0101" => leds <= "0100000";
			WHEN "0110" => leds <= "0001111";
			WHEN "0111" => leds <= "0000000";
			WHEN OTHERS => leds <= "-------";
		END CASE;
END PROCESS;
END Behavior;